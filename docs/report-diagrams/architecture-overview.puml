@startuml
!pragma layout smetana
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam dpi 180
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName "Microsoft YaHei"
skinparam ArrowColor #334155
skinparam defaultTextAlignment center

actor "用户浏览器" as Browser

package "展示层" #EFF6FF {
  component "Vue 页面\n页面与图表" as Pages
  component "Pinia 状态管理\n认证状态" as Store
  component "接口通信层\nAxios + JWT" as Client
  Pages --> Store
  Pages --> Client
}

package "接入层" #ECFEFF {
  component "Nginx / Vite 代理\n静态资源与业务请求转发" as Gateway
}

package "应用层" #FFF7ED {
  component "FastAPI 接口层\n请求处理与身份鉴别" as Routes
  component "业务服务层\n导入 / 分类 / 聚合 / 组织 / 报表" as Services
  Routes --> Services
}

package "异步处理层" #F5F3FF {
  component "Celery 后台任务处理器\n可选异步任务执行能力" as Celery
  component "重试队列处理器\n应用内后台线程" as Retry
}

package "数据与外部服务层" #F0FDF4 {
  database "PostgreSQL / SQLite\n业务数据" as DB
  database "Redis\n任务消息与结果支持" as Redis
  folder "文件存储\n上传文件 + PDF" as Files
  cloud "外部兼容分类接口" as ExternalModel
  component "本地模型服务\n模拟服务 / vLLM" as LocalModel
}

Browser --> Pages : HTTPS / HTTP
Client --> Gateway : 同步接口请求
Gateway --> Routes : 转发业务请求
Services --> DB : SQLAlchemy
Services --> Files : 文件读写

Routes ..> Celery : 可选任务提交
Celery --> Redis : 任务消息
Celery --> DB : 任务读写
Celery --> Files : 导入 / 报表文件

Services --> Retry : 标记为等待处理
Retry --> DB : 取出待处理交易\n保存分类结果
Retry --> ExternalModel : HTTPS
Retry --> LocalModel : HTTP

note right of Retry
异步分类处理流程：
FastAPI 标记待重试交易
→ 后台线程依次处理
→ 调用分类服务
→ 保存分类结果
end note
@enduml
