@startuml
!pragma layout smetana

top to bottom direction

skinparam backgroundColor transparent
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 36
skinparam ranksep 34
skinparam packageStyle rectangle
skinparam dpi 180
hide circle
hide methods

package "用户与组织" {
  class User {
    id: UUID
    email: String
    nickname: String
    createdAt: DateTime
  }

  class Organization {
    id: UUID
    name: String
    ownerId: UUID
  }

  class OrganizationMember {
    id: UUID
    organizationId: UUID
    userId: UUID
    role: String
  }

  User "1" -down- "0..*" Organization
  Organization "1" -down- "1..*" OrganizationMember
}

package "导入与交易" {
  class ImportBatch {
    id: UUID
    userId: UUID
    status: String
    importedAt: DateTime
  }

  class UploadedFile {
    id: UUID
    batchId: UUID
    fileName: String
    fileType: String
  }

  class Transaction {
    id: UUID
    userId: UUID
    occurredAt: DateTime
    amount: Decimal
    description: String
  }

  ImportBatch "1" -down- "1..*" UploadedFile
  UploadedFile "1" -down- "0..*" Transaction
}

package "分类体系" {
  class Category {
    id: UUID
    userId: UUID
    name: String
    parentId: UUID
  }

  class CategoryRule {
    id: UUID
    categoryId: UUID
    keyword: String
    priority: Integer
  }

  class ClassificationResult {
    id: UUID
    transactionId: UUID
    categoryId: UUID
    confidence: Decimal
  }

  class ClassificationCache {
    id: UUID
    userId: UUID
    fingerprint: String
    categoryId: UUID
  }

  Category "1" -down- "0..*" CategoryRule
  CategoryRule -[hidden]down- ClassificationResult
  ClassificationResult -[hidden]down- ClassificationCache
}

package "报表生成" {
  class ReportJob {
    id: UUID
    userId: UUID
    status: String
    requestedAt: DateTime
  }

  class GeneratedReport {
    id: UUID
    jobId: UUID
    userId: UUID
    reportType: String
    storagePath: String
  }

  ReportJob "1" -down- "0..1" GeneratedReport
}

User -[hidden]right- ImportBatch
ImportBatch -[hidden]right- Category
OrganizationMember -[hidden]down- ReportJob
Transaction -right-> ClassificationResult

@enduml
